{"id": "triple-1-basic", "kind": "triple", "note": "Same VLAN id, three meanings: add grows the set, allow-only replaces it, remove of an absent member is a no-op.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}, "cases": [{"verb": "add", "request": "On sw-acc-1, add VLAN 20 to the uplink trunk", "plan": {"device": "sw-acc-1", "operation": "add_trunk_vlans", "interface": "GigabitEthernet1/0/48", "vlans": [20]}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 20, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}}, {"verb": "replace", "request": "On sw-acc-1, allow only VLAN 20 on the uplink trunk", "plan": {"device": "sw-acc-1", "operation": "replace_trunk_vlans", "interface": "GigabitEthernet1/0/48", "vlans": [20]}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [20], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}}, {"verb": "remove", "request": "On sw-acc-1, remove VLAN 20 from the uplink trunk", "plan": {"device": "sw-acc-1", "operation": "remove_trunk_vlans", "interface": "GigabitEthernet1/0/48", "vlans": [20]}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}}]}
