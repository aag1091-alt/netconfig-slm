{"id": "gold-set-native-vlan", "operation": "set_native_vlan", "invariant": "A native VLAN change does not alter the allowed set.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 20], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}, "plan": {"device": "sw-acc-1", "operation": "set_native_vlan", "interface": "GigabitEthernet1/0/48", "vlan_id": 20}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 20], "native_vlan": 20, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}}
{"id": "gold-set-port-mode", "operation": "set_port_mode", "invariant": "A mode toggle preserves access_vlan, trunk_allowed and native_vlan values.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}}, "interfaces": {"GigabitEthernet1/0/9": {"mode": "access", "access_vlan": 20, "trunk_allowed": [10, 20], "native_vlan": 1, "admin": "up", "description": "Flex port", "aliases": []}}}, "plan": {"device": "sw-acc-1", "operation": "set_port_mode", "interface": "GigabitEthernet1/0/9", "mode": "trunk"}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}}, "interfaces": {"GigabitEthernet1/0/9": {"mode": "trunk", "access_vlan": 20, "trunk_allowed": [10, 20], "native_vlan": 1, "admin": "up", "description": "Flex port", "aliases": []}}}}
