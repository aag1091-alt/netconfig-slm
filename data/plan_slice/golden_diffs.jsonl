{"id": "gold-create-vlan", "operation": "create_vlan", "invariant": "create_vlan changes exactly vlans.<id>; no interface path changes.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/1": {"mode": "access", "access_vlan": 10, "trunk_allowed": "all", "native_vlan": 1, "admin": "up", "description": "", "aliases": []}}}, "plan": {"device": "sw-acc-1", "operation": "create_vlan", "vlan_id": 20, "name": "Engineering"}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/1": {"mode": "access", "access_vlan": 10, "trunk_allowed": "all", "native_vlan": 1, "admin": "up", "description": "", "aliases": []}}}}
{"id": "gold-delete-vlan-cascade", "operation": "delete_vlan", "invariant": "delete_vlan cascades: access ports in the VLAN fall back to access_vlan=null and the id is stripped from explicit trunk allowed lists; native_vlan is not rewritten.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/5": {"mode": "access", "access_vlan": 20, "trunk_allowed": "all", "native_vlan": 1, "admin": "up", "description": "Desk port", "aliases": []}, "GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 20, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}, "plan": {"device": "sw-acc-1", "operation": "delete_vlan", "vlan_id": 20}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/5": {"mode": "access", "access_vlan": null, "trunk_allowed": "all", "native_vlan": 1, "admin": "up", "description": "Desk port", "aliases": []}, "GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}}
{"id": "gold-set-access-vlan", "operation": "set_access_vlan", "invariant": "set_access_vlan never changes admin or mode: a down port stays down.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/7": {"mode": "access", "access_vlan": 10, "trunk_allowed": "all", "native_vlan": 1, "admin": "down", "description": "Spare desk", "aliases": []}}}, "plan": {"device": "sw-acc-1", "operation": "set_access_vlan", "interface": "GigabitEthernet1/0/7", "vlan_id": 30}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/7": {"mode": "access", "access_vlan": 30, "trunk_allowed": "all", "native_vlan": 1, "admin": "down", "description": "Spare desk", "aliases": []}}}}
{"id": "gold-add-trunk-canonical", "operation": "add_trunk_vlans", "invariant": "Canonical case: add is union - {10,30} + {20} = {10,20,30}; native VLAN unchanged.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}, "plan": {"device": "sw-acc-1", "operation": "add_trunk_vlans", "interface": "GigabitEthernet1/0/48", "vlans": [20]}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 20, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}}
{"id": "gold-add-trunk-to-all", "operation": "add_trunk_vlans", "invariant": "Adding to trunk_allowed='all' is a no-op; the diff is empty.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": "all", "native_vlan": 1, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}, "plan": {"device": "sw-acc-1", "operation": "add_trunk_vlans", "interface": "GigabitEthernet1/0/48", "vlans": [20]}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": "all", "native_vlan": 1, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}}
{"id": "gold-remove-trunk", "operation": "remove_trunk_vlans", "invariant": "remove is set difference; unlisted members are preserved.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 20, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}, "plan": {"device": "sw-acc-1", "operation": "remove_trunk_vlans", "interface": "GigabitEthernet1/0/48", "vlans": [20]}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}}
{"id": "gold-remove-absent-noop", "operation": "remove_trunk_vlans", "invariant": "Removing an absent VLAN is an idempotent no-op, not an error.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}, "plan": {"device": "sw-acc-1", "operation": "remove_trunk_vlans", "interface": "GigabitEthernet1/0/48", "vlans": [99]}, "after": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "30": {"name": "Voice"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": [10, 30], "native_vlan": 10, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}}
{"id": "gold-remove-from-all-errors", "operation": "remove_trunk_vlans", "invariant": "The compiler refuses to expand 'all': remove from 'all' raises PlanError; the operator must use replace_trunk_vlans.", "before": {"device": "sw-acc-1", "hostname": "switch1", "vlans": {"10": {"name": "Users"}, "20": {"name": "Engineering"}}, "interfaces": {"GigabitEthernet1/0/48": {"mode": "trunk", "access_vlan": 1, "trunk_allowed": "all", "native_vlan": 1, "admin": "up", "description": "Uplink to core", "aliases": ["uplink"]}}}, "plan": {"device": "sw-acc-1", "operation": "remove_trunk_vlans", "interface": "GigabitEthernet1/0/48", "vlans": [20]}, "expected_error": "PlanError"}
